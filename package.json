{
  "name": "terraform-plan-commenter-action",
  "version": "2.1.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14.1"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:check": "node scripts/build.mjs --check",
    "check": "npm run lint && npm run typecheck && npm run build:check && npm run lint:md && npm run test:coverage",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:md": "markdownlint '**/*.md' --ignore node_modules",
    "release": "node scripts/release-cli.ts",
    "release:check": "node scripts/release.mjs --check",
    "release:prepare": "node scripts/release.mjs --prepare"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "@vitest/coverage-v8": "^4.0.16",
    "eslint": "^9.39.2",
    "markdownlint-cli": "^0.49.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.0.16"
  }
}
