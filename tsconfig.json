{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["ES2024"],
    "maxNodeModuleJsDepth": 0,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2024",
    "types": ["node"]
  },
  "include": [
    "eslint.config.js",
    "scripts/build.mjs",
    "scripts/release.mjs",
    "scripts/**/*.test.ts",
    "src/**/*.ts",
    "vitest.config.js"
  ],
  "exclude": [
    "coverage",
    "docs",
    "node_modules"
  ]
}
